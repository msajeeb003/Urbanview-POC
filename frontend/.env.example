# Copy to .env.local. Every NEXT_PUBLIC_* value is inlined into the browser bundle: no secrets here.

# UrbanView API (backend/). The browser calls it directly; CORS_ORIGINS in backend/.env must list
# this app's origin (default http://localhost:3000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional: address the Next.js server uses for server-side fetches (e.g. http://api:8000 in compose).
# API_INTERNAL_BASE_URL=

# Mapbox GL JS. Without a token the map area shows the wireframe's background and the chrome only.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# Market data in the pilot. false (default, the wireframe): the price heatmap card is locked and
# opens the market-data intent modal. true: market layers are free to toggle.
NEXT_PUBLIC_MARKET_DATA_FREE=false

# Language of the shell when the visitor has not chosen one (en | me). en until the client approves
# the Montenegrin copy (src/lib/i18n/strings.ts).
NEXT_PUBLIC_DEFAULT_LANG=en

# Set to false to stop sending analytics events (local debugging).
NEXT_PUBLIC_ANALYTICS_ENABLED=true
