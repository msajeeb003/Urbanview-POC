{
  "name": "@urbanview/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "UrbanView public map: Next.js (App Router) + TypeScript + Tailwind + shadcn/ui, reproducing the approved wireframe.",
  "scripts": {
    "predev": "node scripts/build-map-provider.mjs && node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-map-provider.mjs && node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "design:check": "node scripts/check-wireframe-css.mjs",
    "api:types": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "check": "npm run design:check && npm run typecheck && npm run lint && npm run test",
    "map:provider": "node scripts/build-map-provider.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@urbanview/feasibility-engine": "*",
    "cn": "^0.4.0",
    "mapbox-gl": "^3.31.0",
    "next": "16.3.6",
    "pdfjs-dist": "^6.3.289",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
