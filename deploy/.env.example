# UrbanView on one server: copy to deploy/.env (never commit it) and fill in every "change-me".
# Every backend setting (backend/.env.example, core/config.py) can also be set here; the compose
# file passes this file to the API and the worker.
# Generate secrets with:  openssl rand -hex 24

# --- public names (DNS A / AAAA records → the server) -------------------------------------------
# No domain yet? sslip.io names work with HTTPS: map.203-0-113-10.sslip.io for the IP 203.0.113.10.
SITE_DOMAIN=urbanview.example.com
API_DOMAIN=api.urbanview.example.com
FILES_DOMAIN=files.urbanview.example.com
# The server's public IPv4: typing it into a browser forwards to the map
SERVER_IP=

# --- environment --------------------------------------------------------------------------------
# staging: /docs is on, e-mails go only to MAIL_ALLOWLIST (empty = none leave the server).
# prod: /docs off, e-mails go to everyone. Switch when the site is announced.
APP_ENV=staging
MAIL_ALLOWLIST=you@example.com,@yourcompany.com

# --- database (PostGIS, internal only) ----------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- file storage (MinIO, internal; browsers get signed links via FILES_DOMAIN) -----------------
MINIO_ROOT_USER=urbanview
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
S3_BUCKET=urbanview

# --- staff access to the admin API: token:role[:name], comma separated ---------------------------
# e.g. ADMIN_API_TOKENS=3f9c…long-random…:admin:ops
ADMIN_API_TOKENS=change-me:admin:ops

# --- e-mail (a real SMTP provider on port 587; Hetzner blocks 25 / 465 on new accounts) ---------
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend, SMTP_PASSWORD=<API key>
# Brevo:  SMTP_HOST=smtp-relay.brevo.com, SMTP_USERNAME=<login>, SMTP_PASSWORD=<SMTP key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=UrbanView <no-reply@urbanview.example.com>
ORDER_SUPPORT_EMAIL=support@urbanview.example.com

# --- orders: bank-transfer details shown on the confirmation and in the e-mail ------------------
ORDER_BANK_BENEFICIARY=change-me
ORDER_BANK_IBAN=change-me
ORDER_BANK_NAME=
ORDER_BANK_SWIFT=
ORDER_PRICE_TIERS=500:100,inf:200
ORDER_TURNAROUND_BUSINESS_DAYS=5

# --- geocoding (identifies the operator to the OpenStreetMap services) ---------------------------
# an e-mail or the site URL
GEOCODER_CONTACT=https://urbanview.example.com
# how long the API waits for the public Photon instance (it answers in 1-3 s; the 1500 default
# dropped most answers, so search said "No match"); lower it with a self-hosted GEOCODER_BASE_URL
GEOCODER_TIMEOUT_MS=3000

# --- public map build (baked into the browser bundle: rebuild after a change) -------------------
# Mapbox public token (pk.…), restricted to https://SITE_DOMAIN in the Mapbox account.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
NEXT_PUBLIC_ANALYTICS_ENABLED=true
# en until the client approves the Montenegrin copy, then me
NEXT_PUBLIC_DEFAULT_LANG=en

# Admin console sign-in (Auth.js in the web container): `openssl rand -base64 32`.
AUTH_SECRET=change-me
# Console session length in seconds (24 h); staff sessions on the API end with it:
AUTH_SESSION_MAX_AGE=86400
STAFF_SESSION_DAYS=1
# Temporary, while SMTP_HOST is empty (no sign-in links can be mailed): an admin entry of
# ADMIN_API_TOKENS here opens the console WITHOUT sign-in, as that admin, for every visitor of
# /admin. Leave it empty to require the e-mailed sign-in.
ADMIN_OPEN_ACCESS_TOKEN=

# AI extraction (the worker reads planning PDFs with Claude): an API key with credit for the
# Anthropic-compatible endpoint below (Anthropic, or Cheaper Inference with a ci_live_ key).
# After setting it: docker compose -f deploy/compose.yml --env-file deploy/.env up -d api worker
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com   # or https://api.cheaperinference.com
EXTRACTION_MODEL=claude-sonnet-5
