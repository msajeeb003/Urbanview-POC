# Copy to .env for local development. Never commit .env.
APP_ENV=dev                 # dev | staging | prod
APP_NAME=urbanview-api
LOG_LEVEL=INFO
MUNICIPALITY_ID=podgorica   # selects municipalities/<id>.toml

# PostgreSQL + PostGIS (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://urbanview:urbanview@localhost:5432/urbanview
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis (rate limiting, caches) and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Background jobs (jobs/): every task is a pipeline_jobs row with retries and cost tracking
CELERY_TASK_ALWAYS_EAGER=false      # true runs tasks inline in the API process (tests only)
JOB_MAX_ATTEMPTS=3                  # transient errors (LLM timeout, 429) retried up to this
JOB_RETRY_BASE_SECONDS=30           # backoff: base * 2^(attempt-1) ...
JOB_RETRY_MAX_SECONDS=900           # ... capped here
LLM_PRICE_EUR_PER_MTOK_INPUT=3      # default LLM prices for the cost estimate (EUR / MTok)
LLM_PRICE_EUR_PER_MTOK_OUTPUT=15
LLM_PRICE_TABLE=                    # per-model override, e.g. claude-sonnet-5=3:15,claude-haiku-4-5-20251001=1:5

# AI document extraction (core.extraction, docs/specs/extraction-contract.md); worker only
ANTHROPIC_BASE_URL=https://api.anthropic.com   # set explicitly: a stray env var must not get the key
ANTHROPIC_API_KEY=                  # empty = the Anthropic SDK's own lookup; never commit a key
EXTRACTION_MODEL=claude-sonnet-5      # claude-opus-5 for the hardest pages; haiku lacks adaptive thinking and effort
EXTRACTION_EFFORT=high              # low | medium | high | xhigh | max
EXTRACTION_ADAPTIVE_THINKING=true
EXTRACTION_MAX_TOKENS=32000
EXTRACTION_REFUSAL_FALLBACK=false   # true only on models that document it (Opus 5): fallbacks "default", beta server-side-fallback-2026-07-01
EXTRACTION_TIMEOUT_SECONDS=600
EXTRACTION_LOW_CONFIDENCE=0.7       # items below it are still queued, flagged low_confidence
EXTRACTION_OCR_BACKEND=none         # none: scanned pages stay flagged for manual handling | tesseract
EXTRACTION_OCR_LANGUAGES=srp_latn+srp
EXTRACTION_OCR_DPI=300
EXTRACTION_CALL_RETRIES=2           # per model request, with backoff; then the job retries
EXTRACTION_RETRY_BASE_SECONDS=2
EXTRACTION_RETRY_MAX_SECONDS=30
EXTRACTION_MAX_CHUNKS=400           # chunks x tasks one run may read

# PDF pre-processing (job preprocess_file, docs/specs/pdf-preprocessing.md), cached by checksum
PREPROCESS_PAGE_IMAGE_DPI=150
PREPROCESS_PAGE_IMAGE_MAX_PIXELS=25000000   # large sheets render at a lower dpi
PREPROCESS_SERVE_PAGE_IMAGES=false  # true: the source viewer serves the PNGs (no value highlight)
PREPROCESS_CHUNK_TOKEN_BUDGET=6000
PREPROCESS_CHARS_PER_TOKEN=3
PREPROCESS_MIN_TEXT_DENSITY=2       # chars per 10 000 pt² under which an image page is a scan
PREPROCESS_SCANNED_IMAGE_COVERAGE=0.5
PREPROCESS_TABLE_MAX_PATHS=20000    # table finding is skipped on heavier drawing sheets

# Market-data imports (core.market, job import_market_data, docs/specs/market-data.md)
MARKET_NORMALISE_LLM=auto           # auto: the LLM maps a table only when the rules cannot | never | always
MARKET_MODEL=                       # empty = EXTRACTION_MODEL
MARKET_EFFORT=medium
MARKET_MAX_TOKENS=16000
MARKET_LLM_MAX_ROWS=150             # rows of a sheet the model sees
MARKET_LOW_CONFIDENCE=0.7           # items below it are flagged low_confidence
MARKET_MAX_ROWS=5000                # per sheet
MARKET_MIN_LISTINGS=5               # pasted listings per zone and metric needed for a figure
MARKET_LISTINGS_LOW_PERCENTILE=25
MARKET_LISTINGS_HIGH_PERCENTILE=75

# Publish pipeline (POST /v1/admin/publish): PMTiles archive, retention, tiles pointer
TIPPECANOE_BIN=tippecanoe           # the worker image builds tippecanoe (Dockerfile.worker)
TILE_JOIN_BIN=tile-join
TILES_MIN_ZOOM=8
TILES_MAX_ZOOM=16
TILES_URL_EXPIRES_SECONDS=3600      # lifetime of the signed archive URL (GET /v1/tiles/current)
PUBLISH_KEEP_VERSIONS=3             # versions with archives kept for rollback; older archives pruned
PUBLISH_TMP_DIR=                    # scratch dir for GeoJSON exports and tiles; empty = system temp

# S3-compatible private object storage (MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
# Where browsers reach the bucket (signed PDF / tile links); unset = S3_ENDPOINT_URL.
# S3_PUBLIC_ENDPOINT_URL=https://files.example.com
S3_BUCKET=urbanview-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
SOURCE_URL_EXPIRES_SECONDS=900   # lifetime of the signed URLs from GET /v1/source (60-86400)
PANEL_CACHE_TTL_SECONDS=3600     # /v1/parcels/{id}/panel, /v1/zones/{id}/panel cache; 0 = off

# Staff routes (/v1/admin/*): bearer tokens "token:role[:subject]", comma-separated; roles admin | reviewer | expert.
# Empty = every admin route answers 401. Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKENS=
ADMIN_UPLOAD_MAX_MB=100          # POST /v1/admin/files size limit

# Expert-analysis orders (POST /v1/orders): guest checkout, bank transfer; tiers confirmed by the client later
ORDER_PRICE_TIERS=500:100,inf:200        # "<max area m2>:<price EUR>,...,inf:<price>" (BRD band EUR 50-200)
ORDER_TURNAROUND_BUSINESS_DAYS=5
ORDER_MAX_PER_EMAIL_PER_DAY=5
ORDER_REPORT_LINK_EXPIRES_SECONDS=604800  # delivery e-mail download link lifetime
ORDER_BANK_BENEFICIARY=UrbanView d.o.o. (placeholder)
ORDER_BANK_IBAN=ME00 0000 0000 0000 0000 00 (placeholder)
ORDER_BANK_NAME=
ORDER_BANK_SWIFT=
ORDER_SUPPORT_EMAIL=support@urbanview.io
ORDER_PUBLIC_BASE_URL=http://localhost:3000   # links in e-mails (public status page)

# SMTP (leave SMTP_HOST empty in dev: emails are logged, not sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=UrbanView <no-reply@urbanview.io>

# Per-IP rate limiting (fixed window, Redis-backed)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/health/ready
RATE_LIMIT_REDIS_TIMEOUT_MS=250   # hard budget per Redis call; over it the limiter fails open
RATE_LIMIT_FAIL_OPEN_SECONDS=5    # after a Redis failure, skip the limiter for this long
TRUST_PROXY_HEADERS=false   # true only behind a proxy that sets X-Forwarded-For

# HTTP
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SLOW_REQUEST_MS=2000        # product target: query -> populated panel under 2 s

# Geocoding proxy (GET /v1/geocode): OSM-based autocomplete scoped to the municipality bounds
GEOCODER_PROVIDER=photon            # photon | nominatim (Google: add an adapter + registry entry)
GEOCODER_BASE_URL=                  # empty = the provider's public instance; set for a self-hosted one
GEOCODER_CONTACT=                   # email or URL identifying the operator, sent in User-Agent (OSM usage policies)
GEOCODER_USER_AGENT=                # empty = "<APP_NAME>/<APP_VERSION> (+<GEOCODER_CONTACT>)"
GEOCODER_LANGUAGE=                  # empty = municipality locale; Photon only honours en/de/fr/it
GEOCODER_TIMEOUT_MS=1500
GEOCODER_MAX_RESULTS=8
GEOCODER_MIN_QUERY_LENGTH=2         # shorter queries answer empty without calling the provider
GEOCODER_CACHE_TTL_SECONDS=600      # Redis cache per normalised query; 0 disables
GEOCODER_MIN_INTERVAL_MS=           # empty = provider policy (nominatim 1000, photon 0)
GEOCODER_THROTTLE_WAIT_MS=400       # how long a request may wait for a provider slot before answering empty
GEOCODER_FAILURE_BACKOFF_SECONDS=5  # after a provider failure, answer empty without calling it for this long

# Transactional e-mail (core/mail, send_email job on the email queue). Provider account details
# (Postmark / SES / Resend host, port, credentials, verified sender) are supplied separately.
# Dev: docker compose's Mailpit catches everything (http://localhost:8025). Without SMTP_HOST
# nothing is sent and every row in email_log says "suppressed".
SMTP_USE_SSL=false                 # implicit TLS on 465; false = STARTTLS on SMTP_PORT (587)
SMTP_TIMEOUT_SECONDS=15
MAIL_APP_NAME=UrbanView
MAIL_REPLY_TO=                     # empty = ORDER_SUPPORT_EMAIL
MAIL_ALLOWLIST=                    # staging: only these addresses / @domains are mailed (empty = none)
ADMIN_BASE_URL=http://localhost:3001   # magic links: {ADMIN_BASE_URL}/login?token=...
MAGIC_LINK_EXPIRES_SECONDS=900     # single-use login links
STAFF_SESSION_DAYS=30

