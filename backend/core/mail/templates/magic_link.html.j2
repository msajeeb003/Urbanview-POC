<!doctype html>
<html lang="{{ html_lang }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"></head>
<body style="margin:0;padding:24px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2933;line-height:1.5;">
<div style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:8px;padding:28px;">
  <p style="margin:0 0 20px;font-size:18px;font-weight:bold;color:#0b3d5c;">{{ app_name }} admin</p>

{% if lang == "me" %}
  <p>Prijava za <strong>{{ email }}</strong>:</p>
  <p><a href="{{ login_url }}" style="display:inline-block;padding:10px 18px;background:#0b6e8f;color:#ffffff;text-decoration:none;border-radius:6px;">Prijavi se</a></p>
  <p style="color:#52606d;">Link važi {{ expires_minutes }} minuta i može se iskoristiti samo jednom.
     Ako niste tražili prijavu, zanemarite ovu poruku.</p>
  <p style="color:#52606d;font-size:12px;">{{ login_url }}</p>
  <p>Pitanja: <a href="mailto:{{ support_email }}" style="color:#0b6e8f;">{{ support_email }}</a></p>
{% else %}
  <p>Sign in as <strong>{{ email }}</strong>:</p>
  <p><a href="{{ login_url }}" style="display:inline-block;padding:10px 18px;background:#0b6e8f;color:#ffffff;text-decoration:none;border-radius:6px;">Sign in</a></p>
  <p style="color:#52606d;">The link is valid for {{ expires_minutes }} minutes and works once.
     If you did not request it, ignore this message.</p>
  <p style="color:#52606d;font-size:12px;">{{ login_url }}</p>
  <p>Questions: <a href="mailto:{{ support_email }}" style="color:#0b6e8f;">{{ support_email }}</a></p>
{% endif %}
</div>
</body>
</html>
