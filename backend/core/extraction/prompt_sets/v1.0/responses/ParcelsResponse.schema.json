{
  "$defs": {
    "OutBlock": {
      "additionalProperties": false,
      "properties": {
        "block_ref": {
          "$ref": "#/$defs/OutValue"
        },
        "is_total_row": {
          "type": "boolean"
        },
        "area_m2": {
          "$ref": "#/$defs/OutValue"
        },
        "rules": {
          "$ref": "#/$defs/OutRules"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/OutValue"
          },
          "type": "array"
        }
      },
      "required": [
        "block_ref",
        "is_total_row",
        "area_m2",
        "rules",
        "notes"
      ],
      "type": "object"
    },
    "OutColumn": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "type": "integer"
        },
        "header": {
          "description": "Column header as printed",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "enum": [
                "urban_parcel_number",
                "block_ref",
                "planned_parcel_area_m2",
                "land_use",
                "max_site_coverage_pct",
                "max_far",
                "max_height_m",
                "max_floors",
                "building_line_m",
                "setback_neighbours_m",
                "parking_requirement",
                "min_green_area_pct",
                "utilities"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The field it maps to, or null"
        }
      },
      "required": [
        "table",
        "page",
        "header",
        "field"
      ],
      "type": "object"
    },
    "OutParcel": {
      "additionalProperties": false,
      "properties": {
        "urban_parcel_number": {
          "$ref": "#/$defs/OutValue"
        },
        "block_ref": {
          "$ref": "#/$defs/OutValue"
        },
        "planned_parcel_area_m2": {
          "$ref": "#/$defs/OutValue"
        },
        "rules": {
          "$ref": "#/$defs/OutRules"
        },
        "public_area_relation": {
          "$ref": "#/$defs/OutValue"
        },
        "other_conditions": {
          "items": {
            "$ref": "#/$defs/OutValue"
          },
          "type": "array"
        }
      },
      "required": [
        "urban_parcel_number",
        "block_ref",
        "planned_parcel_area_m2",
        "rules",
        "public_area_relation",
        "other_conditions"
      ],
      "type": "object"
    },
    "OutRules": {
      "additionalProperties": false,
      "properties": {
        "land_use": {
          "$ref": "#/$defs/OutValue"
        },
        "max_site_coverage_pct": {
          "$ref": "#/$defs/OutValue"
        },
        "max_far": {
          "$ref": "#/$defs/OutValue"
        },
        "max_height_m": {
          "$ref": "#/$defs/OutValue"
        },
        "max_floors": {
          "$ref": "#/$defs/OutValue"
        },
        "building_line_m": {
          "$ref": "#/$defs/OutValue"
        },
        "setback_neighbours_m": {
          "$ref": "#/$defs/OutValue"
        },
        "parking_requirement": {
          "$ref": "#/$defs/OutValue"
        },
        "min_green_area_pct": {
          "$ref": "#/$defs/OutValue"
        },
        "utilities": {
          "$ref": "#/$defs/OutValue"
        }
      },
      "required": [
        "land_use",
        "max_site_coverage_pct",
        "max_far",
        "max_height_m",
        "max_floors",
        "building_line_m",
        "setback_neighbours_m",
        "parking_requirement",
        "min_green_area_pct",
        "utilities"
      ],
      "type": "object"
    },
    "OutTableRef": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Table id as given (p7t1) or its caption"
        },
        "row": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Row label as printed, e.g. the parcel no."
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Column header as printed"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cell id as given (r4c11)"
        }
      },
      "type": "object",
      "required": [
        "table",
        "row",
        "column",
        "cell"
      ]
    },
    "OutValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The value exactly as printed (digits, decimal separator, abbreviations, spelling untouched); for a code field, the code. null when the pages do not state it."
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "m",
                "m2",
                "ha",
                "percent",
                "ratio",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the document expresses the value: m, m2, ha, percent (a % sign or a % column), ratio (an index printed as a plain decimal), none (a bare number); null for words."
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Verbatim, contiguous copy of the page text the value is read from (the table cell, or a short phrase with its label); contains the value. For a deferred field, the text that defers it."
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Page number from the page marker"
        },
        "table_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutTableRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "description": "0 to 1: how sure you are the value is legible and belongs to this field",
          "type": "number"
        },
        "absent_reason": {
          "anyOf": [
            {
              "enum": [
                "not_found",
                "deferred"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when value is given; not_found when the pages do not state it; deferred when the document leaves it to a later decision."
        }
      },
      "required": [
        "value",
        "unit",
        "raw_text",
        "page",
        "table_ref",
        "confidence",
        "absent_reason"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "urban_parcels": {
      "items": {
        "$ref": "#/$defs/OutParcel"
      },
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/OutBlock"
      },
      "type": "array"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/OutColumn"
      },
      "type": "array"
    }
  },
  "required": [
    "urban_parcels",
    "blocks",
    "columns"
  ],
  "type": "object"
}
