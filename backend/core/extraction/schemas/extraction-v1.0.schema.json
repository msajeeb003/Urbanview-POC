{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbanview:extraction-result:1.0",
  "x-schema-version": "1.0",
  "$defs": {
    "Amendment": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "amends",
            "amended_by"
          ],
          "title": "Relation",
          "type": "string"
        },
        "document_name": {
          "$ref": "#/$defs/StatedValue"
        }
      },
      "required": [
        "relation",
        "document_name"
      ],
      "title": "Amendment",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "description": "A plan's own subdivision grouping urban parcels ('Blok A', 'Zona B'). Not an UrbanView\nzone: those are internal city divisions and are never extracted from documents.",
      "properties": {
        "block_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Block Ref"
        },
        "block_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Key"
        },
        "total_row": {
          "default": false,
          "description": "Read from a table's totals row: sums, not a rule set",
          "title": "Total Row",
          "type": "boolean"
        },
        "area_m2": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Area M2"
        },
        "rules": {
          "$ref": "#/$defs/RuleFields"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/StatedValue"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "block_ref",
        "area_m2",
        "rules"
      ],
      "title": "Block",
      "type": "object"
    },
    "ColumnMapping": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "header": {
          "title": "Header",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field key the column maps to, or null",
          "title": "Field"
        }
      },
      "required": [
        "page",
        "header"
      ],
      "title": "ColumnMapping",
      "type": "object"
    },
    "Flag": {
      "description": "Why a stated value deserves the reviewer's attention. Flags never remove a value.",
      "enum": [
        "low_confidence",
        "out_of_range",
        "unit_assumed",
        "unit_unexpected",
        "number_ambiguous",
        "text_for_numeric_field",
        "page_corrected",
        "bbox_ambiguous",
        "cell_mismatch",
        "aggregate_row",
        "found_under_other_parcel",
        "land_use_unmapped",
        "unknown_code",
        "floors_not_derivable",
        "date_not_parsed"
      ],
      "title": "Flag",
      "type": "string"
    },
    "FloorCount": {
      "additionalProperties": false,
      "description": "Floors parsed from the local notation (``Po+P+6``) by code, never by the model.",
      "properties": {
        "notation": {
          "title": "Notation",
          "type": "string"
        },
        "below_ground": {
          "minimum": 0,
          "title": "Below Ground",
          "type": "integer"
        },
        "above_ground": {
          "minimum": 0,
          "title": "Above Ground",
          "type": "integer"
        },
        "attic": {
          "description": "Attic / mansard / set-back floors among above_ground",
          "minimum": 0,
          "title": "Attic",
          "type": "integer"
        },
        "rule": {
          "const": "floor-notation-v1",
          "default": "floor-notation-v1",
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "notation",
        "below_ground",
        "above_ground",
        "attic"
      ],
      "title": "FloorCount",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "malformed_leaf",
            "page_not_in_input",
            "raw_text_not_on_page",
            "value_not_in_raw_text",
            "parcel_without_number",
            "duplicate_parcel"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "description": "Where in the result, e.g. 'urban_parcels[3].rules.max_far'",
          "title": "Path",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "candidate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the model returned, kept for the reviewer",
          "title": "Candidate"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "LandUseClass": {
      "description": "UrbanView's land-use classes (product-wide). The document's own wording stays the value;\nthe class is derived from it with the profile's term table or the document's legend.",
      "enum": [
        "residential",
        "residential_mixed",
        "mixed_use",
        "central_activities",
        "tourism",
        "education_social",
        "health",
        "culture",
        "religious",
        "sport_recreation",
        "green_space",
        "traffic_infrastructure",
        "utility_infrastructure",
        "industry",
        "special_purpose",
        "other"
      ],
      "title": "LandUseClass",
      "type": "string"
    },
    "LegendEntry": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "description": "Legend code as printed ('SS'); missing when names only",
          "title": "Code"
        },
        "name": {
          "$ref": "#/$defs/StatedValue"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/LandUseClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "name"
      ],
      "title": "LegendEntry",
      "type": "object"
    },
    "MissingValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "default": null,
          "title": "Value",
          "type": "null"
        },
        "reason": {
          "enum": [
            "not_found",
            "deferred",
            "unverified"
          ],
          "title": "Reason",
          "type": "string"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "deferred: the text that defers it",
          "title": "Raw Text"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "reason"
      ],
      "title": "MissingValue",
      "type": "object"
    },
    "PlanningDocument": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Name"
        },
        "document_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "description": "A document type key of the municipality profile",
          "title": "Document Type"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "description": "adopted | in_progress | superseded, with the evidence",
          "title": "Status"
        },
        "gazette_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Gazette Reference"
        },
        "decision_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Decision Number"
        },
        "decision_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "description": "ISO date; stated keeps the printed form",
          "title": "Decision Date"
        },
        "area_ha": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Area Ha"
        },
        "amendments": {
          "items": {
            "$ref": "#/$defs/Amendment"
          },
          "title": "Amendments",
          "type": "array"
        },
        "rules": {
          "$ref": "#/$defs/RuleFields",
          "description": "Rules the document states for its whole area"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/StatedValue"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "name",
        "document_type",
        "status",
        "gazette_reference",
        "decision_number",
        "decision_date",
        "area_ha",
        "rules"
      ],
      "title": "PlanningDocument",
      "type": "object"
    },
    "ResultStats": {
      "additionalProperties": false,
      "properties": {
        "stated": {
          "default": 0,
          "title": "Stated",
          "type": "integer"
        },
        "missing": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Missing",
          "type": "object"
        },
        "flags": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Flags",
          "type": "object"
        },
        "issues": {
          "default": 0,
          "title": "Issues",
          "type": "integer"
        }
      },
      "title": "ResultStats",
      "type": "object"
    },
    "RuleFields": {
      "additionalProperties": false,
      "description": "The planning rules a document states for one scope (an urban parcel, a block or the whole\ndocument): the Group 1 fields of ``planning_fields`` except the planned parcel area.",
      "properties": {
        "land_use": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Land Use"
        },
        "max_site_coverage_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Max Site Coverage Pct"
        },
        "max_far": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Max Far"
        },
        "max_height_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Max Height M"
        },
        "max_floors": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Max Floors"
        },
        "building_line_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Building Line M"
        },
        "setback_neighbours_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Setback Neighbours M"
        },
        "parking_requirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Parking Requirement"
        },
        "min_green_area_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Min Green Area Pct"
        },
        "utilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Utilities"
        }
      },
      "required": [
        "land_use",
        "max_site_coverage_pct",
        "max_far",
        "max_height_m",
        "max_floors",
        "building_line_m",
        "setback_neighbours_m",
        "parking_requirement",
        "min_green_area_pct",
        "utilities"
      ],
      "title": "RuleFields",
      "type": "object"
    },
    "ScopeRef": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "document",
            "block",
            "urban_parcel"
          ],
          "title": "Level",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "As printed: 'UP 12', 'Blok A'",
          "title": "Ref"
        }
      },
      "required": [
        "level"
      ],
      "title": "ScopeRef",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minimum": 1,
          "title": "Document Id",
          "type": "integer"
        },
        "page": {
          "description": "1-based page of the source PDF",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "x0, y0, x1, y1 in PDF points, origin bottom-left",
          "title": "Bbox"
        },
        "bbox_space": {
          "const": "pdf-points-bottom-left",
          "default": "pdf-points-bottom-left",
          "title": "Bbox Space",
          "type": "string"
        },
        "table_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "document_id",
        "page"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Stated": {
      "additionalProperties": false,
      "description": "The value and unit exactly as the document printed them, before normalisation.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "m",
                "m2",
                "ha",
                "percent",
                "ratio",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "value"
      ],
      "title": "Stated",
      "type": "object"
    },
    "StatedValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Canonical unit: %, m, m², ha or null",
          "title": "Unit"
        },
        "raw_text": {
          "description": "The page text the value was read from",
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "extraction_method": {
          "enum": [
            "text",
            "table",
            "ocr"
          ],
          "title": "Extraction Method",
          "type": "string"
        },
        "stated": {
          "$ref": "#/$defs/Stated"
        },
        "normalisation": {
          "description": "Rules applied to the stated value, in order",
          "items": {
            "type": "string"
          },
          "title": "Normalisation",
          "type": "array"
        },
        "derived": {
          "anyOf": [
            {
              "$ref": "#/$defs/FloorCount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/LandUseClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/Flag"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "value",
        "raw_text",
        "source",
        "confidence",
        "extraction_method",
        "stated"
      ],
      "title": "StatedValue",
      "type": "object"
    },
    "TableRef": {
      "additionalProperties": false,
      "description": "Where in a table a value sits, as printed (row label, column header) plus the grid cell id\nwhen the pipeline gave the model a table grid.",
      "properties": {
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Row label as printed, e.g. 'UP 12'",
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Column header as printed",
          "title": "Column"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grid cell id, e.g. 'r4c11'",
          "title": "Cell"
        }
      },
      "title": "TableRef",
      "type": "object"
    },
    "UrbanParcel": {
      "additionalProperties": false,
      "properties": {
        "urban_parcel_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "description": "As printed, e.g. 'UP 12', 'A116/1'",
          "title": "Urban Parcel Number"
        },
        "parcel_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lookup key derived from the number ('12', 'a116/1')",
          "title": "Parcel Key"
        },
        "block_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Block Ref"
        },
        "planned_parcel_area_m2": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "title": "Planned Parcel Area M2"
        },
        "rules": {
          "$ref": "#/$defs/RuleFields"
        },
        "public_area_relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedValue"
            },
            {
              "$ref": "#/$defs/MissingValue"
            }
          ],
          "description": "Relation to public areas (regulation, access), in the document's words",
          "title": "Public Area Relation"
        },
        "other_conditions": {
          "items": {
            "$ref": "#/$defs/StatedValue"
          },
          "title": "Other Conditions",
          "type": "array"
        }
      },
      "required": [
        "urban_parcel_number",
        "block_ref",
        "planned_parcel_area_m2",
        "rules",
        "public_area_relation"
      ],
      "title": "UrbanParcel",
      "type": "object"
    },
    "UtilityItem": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/ScopeRef"
        },
        "kind": {
          "enum": [
            "water_supply",
            "sewerage",
            "stormwater",
            "electricity",
            "heating",
            "gas",
            "telecom",
            "access_road",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
